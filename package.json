{
  "name": "@samspiri/makeplane-cli",
  "version": "3.0.0",
  "description": "AI-first CLI for Plane: manage work items, projects, cycles, and modules without UUIDs.",
  "type": "module",
  "bin": {
    "pl": "dist/bin/plane.js"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "author": "SamSpiri",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/plane.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "plane",
    "plane-api",
    "project-management",
    "issue-tracker",
    "work-items",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SamSpiri/makeplane-cli.git"
  },
  "homepage": "https://github.com/SamSpiri/makeplane-cli#readme",
  "bugs": {
    "url": "https://github.com/SamSpiri/makeplane-cli/issues"
  },
  "license": "MIT",
  "dependencies": {
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
